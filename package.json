{
  "name": "@temp-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:frontend": "nx run frontend:serve",
    "dev:backend": "nx run backend:serve",
    "dev:all": "nx run-many --target=serve --all --parallel",
    "start": "nx run-many --target=serve --all --parallel",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "build": "nx run-many --target=build --all",
    "workers:counter": "node apps/backend/workers/counterMonitor.js",
    "workers:active": "node apps/backend/workers/activeMonitor.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "spellcheck": "cspell lint \"apps/**/*.{ts,tsx,js,jsx,md}\" --no-progress",
    "ci:check": "npm run format:check && npm run lint && npm run spellcheck",
    "prepare": "husky",
    "cy:open": "npx cypress open --config-file apps/frontend/cypress/cypress.config.ts",
    "cy:run": "npx cypress run --config-file apps/frontend/cypress/cypress.config.ts",
    "cy:ci": "npx cypress run --config-file apps/frontend/cypress/cypress.config.ts --headless"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "cspell lint --no-progress"
    ]
  },
  "private": true,
  "devDependencies": {
    "@nx/cypress": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/react": "^22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/cypress": "^0.1.6",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "10.4.13",
    "cspell": "^10.0.1",
    "cypress": "^15.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "lint-staged": "^17.0.8",
    "nx": "22.3.3",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "serve": "^14.2.6",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-virtual": "3.13.20",
    "@types/react-router-dom": "^5.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "pocketbase": "^0.26.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4"
  }
}
